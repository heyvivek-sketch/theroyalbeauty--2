  updatedAt     DateTime       @updatedAt
}

model Address {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String    @default("Home")
  address    String
  city       String
  pincode    String
  lat        Float?
  lng        Float?
  createdAt  DateTime  @default(now())
  bookings   Booking[]
}

